<Window x:Class="CloudflaredTunnelHost.Views.ExitConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CloudflaredTunnelHost.Controls"
        xmlns:i="clr-namespace:CloudflaredTunnelHost.Infrastructure"
        Style="{StaticResource {x:Type Window}}" Title="프로그램 종료 확인" Width="460" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}">
        <StackPanel>
            <DockPanel Background="{DynamicResource RailBrush}" Height="44">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}" Click="Cancel_Click" ToolTip="계속 사용" AutomationProperties.Name="종료 취소">
                    <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                    <c:SvgIcon Kind="brand" Width="18" Height="18" Stroke="{DynamicResource AccentBrush}" Margin="0,0,9,0"/>
                    <TextBlock Text="터널 호스트" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
            </DockPanel>
            <StackPanel Margin="24" i:Motion.Reveal="True" i:Motion.Stagger="True">
                <TextBlock Text="프로그램을 종료할까요?" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="실행 중인 터널과 다운로드 작업도 함께 중지됩니다. 종료하면 현재 공개 주소는 더 이상 사용할 수 없습니다." Foreground="{DynamicResource MutedBrush}" LineHeight="22" Margin="0,0,0,24"/>
                <TextBlock x:Name="UnsavedWarning" Text="입력 오류가 있는 설정은 저장되지 않습니다. 계속 사용을 눌러 수정할 수 있습니다." Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,0,18" Visibility="{Binding HasInputErrors, Converter={StaticResource BoolVisibility}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="계속 사용" IsDefault="True" IsCancel="True" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button x:Name="ConfirmButton" Content="프로그램 종료" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
