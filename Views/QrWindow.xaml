<Window x:Class="CloudflaredTunnelHost.Views.QrWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="터널 QR 코드" Width="460" Height="680" MinWidth="360" MinHeight="480" WindowStartupLocation="CenterOwner" Icon="/CloudflaredTunnelHost;component/Assets/Branding/app.ico" Language="ko-KR" PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel Margin="28">
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,16,0,0"><Button x:Name="CopyImageButton" Content="이미지 복사" Command="{Binding CopyQrCommand}" Margin="0,0,8,8"/><Button Content="PNG 저장" Command="{Binding SaveQrCommand}" Margin="0,0,8,8"/><Button x:Name="CloseButton" Content="닫기" ToolTip="Esc" Click="CloseWindow" MinWidth="64" Margin="0,0,0,8"/></WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,8,0"><StackPanel>
        <TextBlock Text="스캔해서 연결하세요." FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock Text="QR 코드는 이 기기에서 생성됩니다. 외부 QR 서버에 주소를 전송하지 않습니다." Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,20"/>
        <Border Background="White" Padding="16" CornerRadius="8" MaxWidth="320"><Image Source="{Binding QrImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="공개 URL QR 코드"/></Border>
        <TextBox Text="{Binding PublicUrl, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,18,0,12" Background="Transparent" BorderThickness="0" Padding="0" TextAlignment="Center" AutomationProperties.Name="QR 코드의 공개 주소"/>
        <TextBlock Text="{Binding AccessDescription}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,16"/>
        <TextBlock Text="터널이 종료되거나 주소가 바뀌면 이 창은 닫힙니다. 저장한 이미지는 삭제되지 않지만 이전 주소로는 접속할 수 없습니다." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer></DockPanel>
</Window>
