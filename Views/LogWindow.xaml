<Window x:Class="CloudflaredTunnelHost.Views.LogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CloudflaredTunnelHost.Controls"
        Style="{StaticResource {x:Type Window}}" Title="활동 로그" Width="940" Height="680" MinWidth="620" MinHeight="440" WindowStartupLocation="CenterOwner" Icon="/CloudflaredTunnelHost;component/Assets/Branding/app.ico" Language="ko-KR" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Background="{DynamicResource BackgroundBrush}" Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding LogCount, StringFormat={}최근 {0}개}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Text="활동 로그" FontSize="24" FontWeight="SemiBold"/></DockPanel>
            <TextBlock Text="실시간 로그를 검색하고 저장하세요. 메인 화면에는 필터와 관계없이 최근 기록을 표시합니다." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
            <StackPanel><Label Target="{Binding ElementName=LogSearchInput}" Content="로그 검색" Foreground="{DynamicResource MutedBrush}" Padding="0,0,0,8"/><TextBox x:Name="LogSearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="로그 검색" ToolTip="로그 메시지와 레벨에서 검색"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="레벨" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding FilterLevels}" SelectedItem="{Binding LevelFilter}" AutomationProperties.Name="로그 레벨 필터"/></StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <c:LogListBox x:Name="ActivityLog" Style="{StaticResource {x:Type ListBox}}" ItemsSource="{Binding FilteredLogs}" ItemTemplate="{StaticResource LogEntryTemplate}" AutoScroll="{Binding AutoScroll}" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="실시간 활동 로그" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <TextBlock Text="표시할 로그가 없습니다. 검색어나 레벨 필터를 확인하세요." HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFilteredLogs}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="닫기" ToolTip="Esc" Click="CloseWindow" MinWidth="72" Margin="8,0,0,8"/>
            <WrapPanel><CheckBox Content="자동 스크롤" IsChecked="{Binding AutoScroll}" Margin="0,0,16,8"/><Button Content="복사" Command="{Binding CopyLogsCommand}" Margin="0,0,8,8"/><Button Content="저장" Command="{Binding SaveLogsCommand}" Margin="0,0,8,8"/><Button Content="초기화" Command="{Binding ClearLogsCommand}" Margin="0,0,0,8"/></WrapPanel>
        </DockPanel>
        <TextBlock Grid.Row="4" Text="{Binding Notice}" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>
