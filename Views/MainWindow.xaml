<Window x:Class="CloudflaredTunnelHost.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CloudflaredTunnelHost.Controls" xmlns:i="clr-namespace:CloudflaredTunnelHost.Infrastructure"
        Style="{StaticResource {x:Type Window}}" Title="Cloudflared Tunnel Host" Width="1180" Height="860" MinWidth="860" MinHeight="640" WindowStartupLocation="CenterScreen" Icon="/CloudflaredTunnelHost;component/Assets/Branding/app.ico" Language="ko-KR" WindowStyle="SingleBorderWindow" PreviewKeyDown="OnPreviewKeyDown">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Window.InputBindings><KeyBinding Key="L" Modifiers="Control+Shift" Command="{Binding ShowLogsCommand}"/><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveSettingsCommand}"/><KeyBinding Key="L" Modifiers="Control" Command="{Binding CopyUrlCommand}"/></Window.InputBindings>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="TitleBar" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                    <c:SvgIcon Kind="brand" Stroke="{DynamicResource AccentBrush}" Width="19" Height="19" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,22,0" IsHitTestVisible="False">
                    <Ellipse x:Name="CaptionStatusDot" Width="6" Height="6" Margin="0,0,8,0">
                        <Ellipse.Style><Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource MutedBrush}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers>
                        </Style></Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="CaptionStateLabel" Text="{Binding StateLabel}" i:Motion.Watch="{Binding StateLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeCaptionButton" Style="{StaticResource CaptionButton}" Click="MinimizeWindow_Click" ToolTip="최소화" AutomationProperties.Name="창 최소화">
                        <Path Data="M 0,5 L 10,5" Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="MaximizeCaptionButton" Click="MaximizeWindow_Click">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                            <Setter Property="ToolTip" Value="최대화"/><Setter Property="AutomationProperties.Name" Value="창 최대화"/>
                            <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter Property="ToolTip" Value="이전 크기로"/><Setter Property="AutomationProperties.Name" Value="창 크기 복원"/>
                            </DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                        <Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1">
                            <Path.Style><Style TargetType="Path">
                                <Setter Property="Data" Value="M 1,1 L 11,1 11,11 1,11 Z"/>
                                <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="Data" Value="M 3,3 L 3,1 11,1 11,9 9,9 M 1,3 L 9,3 9,11 1,11 Z"/>
                                </DataTrigger></Style.Triggers>
                            </Style></Path.Style>
                        </Path>
                    </Button>
                    <Button x:Name="CloseCaptionButton" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow_Click" ToolTip="닫기 (트레이 설정에 따라 숨기기 또는 종료)" AutomationProperties.Name="창 닫기">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,28,16,20">
            <DockPanel LastChildFill="True" i:Motion.Reveal="True" i:Motion.Stagger="True">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,34">
                    <c:SvgIcon Kind="brand" Stroke="{DynamicResource AccentBrush}" Width="34" Height="34" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                    <TextBlock Text="터널 호스트" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Cloudflare Quick Tunnel" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,18,8,12">
                        <StackPanel><TextBlock Text="QUICK TUNNEL" FontSize="10" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="개발용 임시 공개 연결" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource NavButton}" ToolTip="다크 / 라이트 테마 전환" AutomationProperties.Name="테마 전환"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="theme" Stroke="{DynamicResource MutedBrush}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="테마 전환"/></StackPanel></Button>
                    <Button Command="{Binding ExitCommand}" Style="{StaticResource NavButton}" ToolTip="터널을 중지하고 프로그램을 완전히 종료합니다"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="exit" Stroke="{DynamicResource MutedBrush}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="프로그램 종료"/></StackPanel></Button>
                    <TextBlock Text="Cloudflared Tunnel Host" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="14,18,0,0"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="DashboardNavigation" Command="{Binding ShowDashboardCommand}" Style="{StaticResource DashboardNav}" AutomationProperties.Name="대시보드"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="dashboard" Stroke="{DynamicResource AccentBrush}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="대시보드"/></StackPanel></Button>
                    <Button x:Name="SettingsNavigation" Command="{Binding ShowSettingsCommand}" Style="{StaticResource SettingsNav}" AutomationProperties.Name="고급 설정"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="settings" Stroke="{DynamicResource MutedBrush}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="고급 설정"/></StackPanel></Button>
                    <Button x:Name="LogsNavigation" Command="{Binding ShowLogsCommand}" Style="{StaticResource LogsNav}" AutomationProperties.Name="활동 로그"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="terminal" Stroke="{DynamicResource MutedBrush}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="활동 로그"/></StackPanel></Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <c:TransitionPresenter x:Name="PageTransition" Grid.Column="1" Margin="{StaticResource PagePadding}" Index="{Binding PageIndex}" HorizontalTransitionIndex="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><c:SvgIcon Kind="shield" Stroke="{DynamicResource MutedBrush}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="개발 및 테스트용" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel>
                <TextBlock Text="내 서버를 인터넷에 연결" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
            </DockPanel>
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0" Focusable="False">
                <ScrollViewer.Style><Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsDashboard}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></ScrollViewer.Style>
                <StackPanel>
                    <StackPanel Visibility="{Binding IsDashboard, Converter={StaticResource BoolVisibility}}">
                        <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="로컬 서버 공유" FontSize="28" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,16,0" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <ProgressBar Height="3" IsIndeterminate="{Binding AnimateProgress}" Value="35" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsConnecting, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,14" AutomationProperties.Name="터널 연결 진행"/>
                        <Border x:Name="ConnectionPanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
                            <Border.Style><Style TargetType="Border"><Style.Triggers>
                                <DataTrigger Binding="{Binding HasUrl}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers></Style></Border.Style>
                            <StackPanel>
                                <TextBlock Text="1   연결할 서버" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <StackPanel x:Name="ConnectionForm" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Label Target="{Binding ElementName=ServiceTypeInput}" Padding="0,0,0,6" Content="서비스 유형" Foreground="{DynamicResource MutedBrush}"/>
                                            <ComboBox x:Name="ServiceTypeInput" ItemsSource="{Binding ServiceTypes}" SelectedItem="{Binding ServiceType}" AutomationProperties.Name="서비스 유형"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Target="{Binding ElementName=PortInput}" Padding="0,0,0,6" Content="로컬 포트" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBox x:Name="PortInput" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" MaxLength="5" FontFamily="Consolas" AutomationProperties.Name="로컬 포트" AutomationProperties.HelpText="개발 서버에 표시된 포트 번호. 예: 3000, 5173, 8000, 8080" ToolTip="개발 서버 주소가 localhost:3000이면 3000을 입력하세요."/>
                                            <TextBlock Text="{Binding PortError}" Style="{StaticResource FieldError}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="개발 서버에 표시된 포트 번호를 입력하세요. 예: 3000, 5173, 8000" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                                </StackPanel>
                                <DockPanel Margin="0,10,0,0">
                                    <c:SvgIcon Kind="server" Stroke="{DynamicResource MutedBrush}" Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding LocalPreview}" FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SharePanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="2   공개 주소로 공유" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <StackPanel x:Name="SharePlaceholder">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers><DataTrigger Binding="{Binding HasUrl}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="터널을 시작하면 여기에 주소가 나타납니다." FontSize="14" Margin="0,0,0,6"/>
                                    <TextBlock Text="로컬 서버는 나중에 실행해도 됩니다. 준비된 주소를 복사하거나 QR 코드로 공유하세요." Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <StackPanel x:Name="ShareActions" Visibility="{Binding HasUrl, Converter={StaticResource BoolVisibility}}" i:Motion.Reveal="True" i:Motion.Stagger="True">
                                    <TextBox x:Name="PublicUrlInput" Text="{Binding PublicUrl, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="16" Padding="12,10" TextWrapping="Wrap" AutomationProperties.Name="공개 터널 URL"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button x:Name="CopyUrlButton" Command="{Binding CopyUrlCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" ToolTip="공개 주소 복사 / Ctrl+L" AutomationProperties.Name="공개 주소 복사">
                                            <StackPanel Orientation="Horizontal"><c:SvgIcon Kind="copy" Stroke="{DynamicResource AccentTextBrush}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="주소 복사" Foreground="{DynamicResource AccentTextBrush}"/></StackPanel>
                                        </Button>
                                        <Button Command="{Binding OpenUrlCommand}" Margin="0,0,8,8" ToolTip="기본 브라우저에서 열기" AutomationProperties.Name="공개 주소를 브라우저에서 열기">
                                            <StackPanel Orientation="Horizontal"><c:SvgIcon Kind="external" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="브라우저 열기"/></StackPanel>
                                        </Button>
                                        <Button Command="{Binding ShowQrCommand}" Margin="0,0,0,8" ToolTip="휴대폰 카메라로 스캔할 QR 코드" AutomationProperties.Name="공개 주소 QR 코드">
                                            <StackPanel Orientation="Horizontal"><c:SvgIcon Kind="qr" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="QR 코드"/></StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding UrlDescription}" Margin="0,10,0,4"/>
                                    <TextBlock Text="{Binding Reachability}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,12"/>
                                    <DockPanel Margin="0,0,0,10">
                                        <c:SvgIcon Kind="server" Stroke="{DynamicResource MutedBrush}" Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding LocalPreview}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                    </DockPanel>
                                    <WrapPanel Margin="0,2,0,10">
                                        <TextBlock Text="연결 시간  " Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding Uptime}" FontFamily="Consolas" FontSize="12" Margin="0,0,20,0"/>
                                        <TextBlock Text="{Binding AttemptText}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                    </WrapPanel>
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AccessDescription}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                        <TextBlock Text="중지하거나 다시 연결하면 주소가 바뀔 수 있습니다. 민감한 서비스는 공개하지 마세요." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="{Binding IsAdvanced, Converter={StaticResource BoolVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="고급 설정" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="터널 시작 시 설정이 자동 저장됩니다. 변경 사항은 아래 설정 저장으로 미리 보관할 수 있습니다." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>
                <TabControl x:Name="SettingsTabs" Grid.Row="1" SelectionChanged="SettingsTabs_SelectionChanged" AutomationProperties.Name="설정 카테고리">
                    <TabItem x:Name="ConnectionTab" Header="연결">
                        <ScrollViewer x:Name="ConnectionSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0" Focusable="False">
                        <StackPanel x:Name="ConnectionSettings" IsEnabled="{Binding CanEdit}" i:Motion.Reveal="True" i:Motion.Stagger="True">
                            <TextBlock Text="연결 프로토콜" Style="{StaticResource SectionTitle}"/>
                            <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" Width="220" HorizontalAlignment="Left" Margin="0,8,0,12" AutomationProperties.Name="연결 프로토콜"/>
                            <TextBlock Text="auto는 cloudflared가 프로토콜을 선택합니다. QUIC이 방화벽에 차단되면 http2를 시도하세요." Style="{StaticResource Caption}"/>
                            <CheckBox Content="HTTPS 서버 인증서 검증 생략" IsChecked="{Binding NoTlsVerify}" IsEnabled="{Binding IsHttps}" ToolTip="HTTPS 서비스에서만 적용됩니다. 기본값은 안전한 인증서 검증 사용입니다."/>
                            <Border Visibility="{Binding NoTlsVerify, Converter={StaticResource BoolVisibility}}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0" Padding="12,4" Margin="0,0,0,18"><TextBlock Text="인증서 검증을 끄면 서버 신원을 확인하지 않습니다. 공격자가 로컬 연결을 가로챌 위험이 있습니다. 자체 서명 개발 인증서가 필요한 환경에서만 사용하세요." Foreground="{DynamicResource AccentBrush}" FontSize="12"/></Border>
                            <TextBlock Text="연결 복구" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                            <CheckBox Content="연결이 끊어지면 자동으로 다시 연결" IsChecked="{Binding AutoReconnect}"/>
                            <DockPanel Margin="0,4,0,8"><Label Target="{Binding ElementName=RetryInput}" Content="최대 재시도 횟수 (0~10)" Foreground="{DynamicResource TextBrush}" Padding="0" VerticalAlignment="Center"/><TextBox x:Name="RetryInput" Text="{Binding RetryText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Width="80" Margin="16,0,0,0" HorizontalAlignment="Left" MaxLength="2" AutomationProperties.Name="자동 재연결 최대 횟수"/></DockPanel>
                            <TextBlock Text="{Binding RetryError}" Style="{StaticResource FieldError}" Margin="0,0,0,8"/>
                            <TextBlock Text="재시도하면 새로운 임시 주소가 발급될 수 있습니다. 중지 / 취소는 재시도 대기도 즉시 취소합니다." Style="{StaticResource Caption}"/>
                            <TextBlock Text="실행 중인 연결 설정은 터널 중지 후 변경할 수 있습니다." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="AccessTab" Header="접근 제한">
                        <ScrollViewer x:Name="AccessSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0" Focusable="False">
                        <StackPanel x:Name="AccessSettings" IsEnabled="{Binding CanEdit}" i:Motion.Reveal="True" i:Motion.Stagger="True">
                            <TextBlock Text="접근 제한" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="허용할 이메일 주소 (쉼표로 구분)" Style="{StaticResource Caption}" Margin="0,10,0,8"/>
                            <TextBox x:Name="AllowedEmailsInput" Text="{Binding AllowedEmails, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="접근 허용 이메일" ToolTip="비워두면 공개 접근을 허용합니다. 입력하면 CLI 지원 여부를 검사하고 PIN 인증을 요구합니다."/>
                            <TextBlock Text="{Binding EmailError}" Style="{StaticResource FieldError}"/>
                            <TextBlock Text="{Binding EmailSupportText}" Style="{StaticResource Caption}" Margin="0,8,0,6"/>
                            <TextBlock Text="비워두면 주소를 아는 누구나 접근합니다. 이메일 제한은 최신 CLI의 --allowed-mail 기능을 사용하며 브라우저 PIN 인증이 필요합니다. 지원하지 않는 버전에서는 실행을 차단합니다." Style="{StaticResource Caption}" Margin="0,0,0,18"/>
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="LoggingTab" Header="로그">
                        <ScrollViewer x:Name="LoggingSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0" Focusable="False">
                        <StackPanel i:Motion.Reveal="True" i:Motion.Stagger="True">
                            <TextBlock Text="Cloudflared 로그" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="로그 레벨" Style="{StaticResource Caption}" Margin="0,8,0,8"/>
                            <ComboBox x:Name="LogLevelInput" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" IsEnabled="{Binding CanEdit}" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="Cloudflared 로그 레벨"/>
                            <TextBlock Text="로그 레벨은 다음 터널 시작 시 적용됩니다. debug는 더 많은 요청 정보를 기록할 수 있습니다." Style="{StaticResource Caption}" Margin="0,10,0,20"/>
                            <TextBlock Text="로그 저장" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="SaveLogFileInput" Content="로그를 파일에 자동 저장 (5MB 순환 보관)" IsChecked="{Binding SaveLogFile}"/>
                            <TextBlock Text="공개 주소·이메일·일반적인 토큰 값은 로그에서 가립니다. 공유 전에 남은 개인정보와 서비스 응답 정보를 직접 확인하세요." Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                            <Button Command="{Binding OpenLogFolderCommand}" Content="로그 폴더 열기" HorizontalAlignment="Left"/>
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="AppTab" Header="앱·트레이">
                        <ScrollViewer x:Name="AppSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0" Focusable="False">
                        <StackPanel x:Name="RuntimeSettings" i:Motion.Reveal="True" i:Motion.Stagger="True">
                            <TextBlock Text="앱 시작과 시스템 트레이" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="터널 실행 중에도 변경할 수 있습니다. 트레이·알림·로그 저장은 즉시, 앱 시작 옵션은 다음 실행부터 적용됩니다." Style="{StaticResource Caption}" Margin="0,6,0,10"/>
                            <CheckBox Content="앱을 실행하면 마지막 설정으로 터널 시작" x:Name="StartTunnelOnLaunchInput" IsChecked="{Binding StartTunnelOnLaunch}"/>
                            <TextBlock Text="켜면 앱 시작 즉시 로컬 서비스가 공개될 수 있습니다. Windows 로그인 자동 실행을 등록하는 옵션은 아닙니다." Style="{StaticResource Caption}"/>
                            <CheckBox Content="앱을 실행하면 트레이로 숨기기" x:Name="StartInTrayInput" IsChecked="{Binding StartInTray}"/>
                            <CheckBox Content="최소화하면 트레이로 숨기기" x:Name="MinimizeToTrayInput" IsChecked="{Binding MinimizeToTray}"/>
                            <CheckBox Content="창 닫기 버튼을 누르면 트레이로 숨기기" x:Name="CloseToTrayInput" IsChecked="{Binding CloseToTray}"/>
                            <CheckBox Content="터널 연결·종료·재연결 이벤트를 Windows 알림으로 표시" x:Name="NotificationsInput" IsChecked="{Binding Notifications}"/>
                            <TextBlock Text="연결 완료·종료·로컬 서버 대기·재연결·오류를 알려드립니다. 알림을 누르면 앱을 엽니다." Style="{StaticResource Caption}"/>
                            <TextBlock Text="프로그램 종료를 선택하면 확인 후 터널과 앱을 종료합니다. 닫기 버튼의 트레이 숨기기 설정은 그대로 유지됩니다." Style="{StaticResource Caption}" Margin="0,0,0,24"/>
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="UpdatesTab" Header="업데이트">
                        <ScrollViewer x:Name="UpdateSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0" Focusable="False">
                        <StackPanel i:Motion.Reveal="True" i:Motion.Stagger="True">
                            <TextBlock Text="Cloudflared 관리" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Version}" FontFamily="Consolas" Margin="0,8,0,10"/>
                            <TextBlock Text="{Binding ReleaseText}" Style="{StaticResource Caption}"/>
                            <TextBlock Text="공식 GitHub 배포 파일의 SHA256과 Windows 실행 파일 형식을 확인한 후 교체합니다. 실패하거나 취소하면 기존 버전은 그대로 유지됩니다." Style="{StaticResource Caption}" Margin="0,0,0,14"/>
                            <WrapPanel><Button Command="{Binding CheckUpdateCommand}" Content="업데이트 확인" Margin="0,0,10,8"/><Button Command="{Binding InstallCommand}" Content="최신 버전 설치 / 복구" Margin="0,0,0,8"/></WrapPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
            <Grid x:Name="LogsPage" Grid.Row="1" Visibility="{Binding IsLogs, Converter={StaticResource BoolVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18" i:Motion.Reveal="True">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Logs.Count, StringFormat={}최근 {0}개}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Text="활동 로그" FontSize="28" FontWeight="SemiBold"/></DockPanel>
                    <TextBlock Text="실시간 기록을 검색하고 필요한 로그를 복사하거나 저장하세요." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,14" i:Motion.Reveal="True">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                    <StackPanel><Label Target="{Binding ElementName=LogSearchInput}" Content="로그 검색" Foreground="{DynamicResource MutedBrush}" Padding="0,0,0,8"/><TextBox x:Name="LogSearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="로그 검색" ToolTip="로그 메시지와 레벨에서 검색"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="레벨" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding FilterLevels}" SelectedItem="{Binding LevelFilter}" AutomationProperties.Name="로그 레벨 필터"/></StackPanel>
                </Grid>
                <Border Grid.Row="2" Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="4">
                    <Grid>
                        <c:LogListBox x:Name="FullActivityLog" Style="{StaticResource {x:Type ListBox}}" ItemsSource="{Binding FilteredLogs}" ItemTemplate="{StaticResource LogEntryTemplate}" AutoScroll="{Binding AutoScroll}" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="실시간 활동 로그" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        <TextBlock Text="표시할 로그가 없습니다. 검색어나 레벨 필터를 확인하세요." HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding HasFilteredLogs}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                    <CheckBox Content="자동 스크롤" IsChecked="{Binding AutoScroll}" Margin="0,0,16,8"/>
                    <Button Content="복사" Command="{Binding CopyLogsCommand}" Margin="0,0,8,8"/>
                    <Button Content="저장" Command="{Binding SaveLogsCommand}" Margin="0,0,8,8"/>
                    <Button Content="초기화" Command="{Binding ClearLogsCommand}" Margin="0,0,8,8"/>
                    <Button x:Name="LogsBackButton" Content="공유 화면으로" Command="{Binding ShowDashboardCommand}" ToolTip="Esc" Margin="0,0,0,8"/>
                </WrapPanel>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,14,0,0">
                <Border.Style><Style TargetType="Border"><Style.Triggers>
                    <DataTrigger Binding="{Binding IsLogs}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers></Style></Border.Style>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10" Visibility="{Binding HasInputErrors, Converter={StaticResource BoolVisibility}}">
                        <Button x:Name="ReviewInputButton" DockPanel.Dock="Right" Content="입력값 수정" Click="ReviewInput_Click" IsEnabled="{Binding CanEdit}" MinHeight="30" Padding="10,5" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding InputError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                    </DockPanel>
                    <WrapPanel>
                        <Button x:Name="StartButton" Command="{Binding StartCommand}" Margin="0,0,10,8" MinWidth="150" AutomationProperties.Name="터널 시작">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanEdit}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsAdvanced}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style></Button.Style>
                            <StackPanel Orientation="Horizontal"><c:SvgIcon Kind="play" Stroke="{DynamicResource AccentTextBrush}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="터널 시작" Foreground="{DynamicResource AccentTextBrush}"/></StackPanel>
                        </Button>
                        <Button x:Name="StopButton" Command="{Binding StopCommand}" Margin="0,0,10,8" MinWidth="140" AutomationProperties.Name="{Binding StopLabel}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers><DataTrigger Binding="{Binding CanEdit}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                            <StackPanel Orientation="Horizontal"><c:SvgIcon Kind="stop" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="{Binding StopLabel}"/></StackPanel>
                        </Button>
                        <Button Command="{Binding ShowSettingsCommand}" Visibility="{Binding IsDashboard, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8" Background="Transparent" BorderThickness="0" Content="고급 설정"/>
                        <Button x:Name="SaveSettingsButton" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsAdvanced, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,8" Content="설정 저장" ToolTip="Ctrl+S"/>
                        <Button Command="{Binding ShowDashboardCommand}" Visibility="{Binding IsAdvanced, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8" Background="Transparent" BorderThickness="0" Content="공유 화면으로"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ActionHint}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
            <Border x:Name="WorkPanel" Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,12,0,0" Visibility="{Binding IsWorking, Converter={StaticResource BoolVisibility}}" i:Motion.Watch="{Binding IsWorking}"><StackPanel><TextBlock Text="{Binding WorkText}" Margin="0,0,0,10"/><ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Maximum="100" Height="4" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="다운로드 진행률"/></StackPanel></Border>
            <Border x:Name="LogPanel" Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                <Border.Style><Style TargetType="Border"><Style.Triggers>
                    <DataTrigger Binding="{Binding IsLogs}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsAdvanced}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers></Style></Border.Style>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ShowLogsCommand}" Content="로그 검색 · 저장" MinHeight="30" Padding="10,5" ToolTip="메인 창에서 활동 로그 보기 / Ctrl+Shift+L"/>
                        <CheckBox DockPanel.Dock="Right" Content="최근 로그" IsChecked="{Binding LogsOpen}" Margin="0,0,12,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><c:SvgIcon Kind="terminal" Stroke="{DynamicResource MutedBrush}" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="활동 로그" FontWeight="SemiBold"/><TextBlock Text="{Binding LogCount, StringFormat={}  /  {0}개}" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
                    </DockPanel>
                    <Grid Visibility="{Binding LogsOpen, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0" i:Motion.Reveal="True">
                        <c:LogListBox x:Name="ActivityLog" Style="{StaticResource {x:Type ListBox}}" ItemsSource="{Binding Logs}" ItemTemplate="{StaticResource LogEntryTemplate}" AutoScroll="{Binding AutoScroll}" Height="76" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="최근 활동 로그" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        <TextBlock Text="아직 기록된 로그가 없습니다." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LogCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Row="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,8,0,0" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}" i:Motion.Watch="{Binding Notice}">
                <DockPanel><Button DockPanel.Dock="Right" Command="{Binding DismissNoticeCommand}" Content="닫기" MinHeight="28" Padding="8,3" Margin="12,0,0,0"/><TextBlock Text="{Binding Notice}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
            </Border>
        </Grid>
        </c:TransitionPresenter>
        </Grid>
    </Grid>
</Window>
