<Window x:Class="CloudflaredTunnelHost.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CloudflaredTunnelHost.Controls" xmlns:i="clr-namespace:CloudflaredTunnelHost.Infrastructure"
        Style="{StaticResource {x:Type Window}}" Title="Cloudflared Tunnel Host" Width="1180" Height="860" MinWidth="860" MinHeight="640" WindowStartupLocation="CenterScreen" Icon="/CloudflaredTunnelHost;component/Assets/Branding/app.ico" Language="ko-KR">
    <Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveSettingsCommand}"/><KeyBinding Key="L" Modifiers="Control" Command="{Binding CopyUrlCommand}"/></Window.InputBindings>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,28,16,20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,34">
                    <c:SvgIcon Kind="brand" Stroke="{DynamicResource AccentBrush}" Width="34" Height="34" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                    <TextBlock Text="TUNNEL HOST" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Cloudflare Quick Tunnel" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,18,8,12">
                        <StackPanel><TextBlock Text="LOCAL TO GLOBAL" FontSize="10" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="작은 서버를 더 넓은 세상으로." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource NavButton}" ToolTip="다크 / 라이트 테마 전환" AutomationProperties.Name="테마 전환"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="theme" Stroke="{DynamicResource MutedBrush}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="테마 전환"/></StackPanel></Button>
                    <Button Command="{Binding ExitCommand}" Style="{StaticResource NavButton}" ToolTip="터널을 중지하고 프로그램을 완전히 종료합니다"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="exit" Stroke="{DynamicResource MutedBrush}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="프로그램 종료"/></StackPanel></Button>
                    <TextBlock Text="WPF EDITION / 2.0" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="14,18,0,0"/>
                </StackPanel>
                <StackPanel>
                    <Button Command="{Binding ShowDashboardCommand}" Style="{StaticResource DashboardNav}" AutomationProperties.Name="대시보드"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="dashboard" Stroke="{DynamicResource AccentBrush}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="대시보드"/></StackPanel></Button>
                    <Button Command="{Binding ShowSettingsCommand}" Style="{StaticResource SettingsNav}" AutomationProperties.Name="고급 설정"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="settings" Stroke="{DynamicResource MutedBrush}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="고급 설정"/></StackPanel></Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><c:SvgIcon Kind="shield" Stroke="{DynamicResource MutedBrush}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="개발 및 테스트용" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel>
                <TextBlock Text="연결 워크스페이스" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
            </DockPanel>
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0" Focusable="False">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsDashboard, Converter={StaticResource BoolVisibility}}" i:Motion.Watch="{Binding IsDashboard}">
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="하나의 연결, 새로운 가능성." Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding StateLabel}" FontSize="36" FontWeight="SemiBold" i:Motion.Watch="{Binding State}"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,20,0" MaxWidth="610" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Width="76" Height="76" VerticalAlignment="Top" Margin="16,24,0,0"><c:SvgIcon Kind="{Binding StatusIcon}" Stroke="{Binding State, Converter={StaticResource StateBrush}}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" i:Motion.Watch="{Binding State}"/></Border>
                        </Grid>
                        <ProgressBar Height="3" IsIndeterminate="{Binding AnimateProgress}" Value="35" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsConnecting, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16" AutomationProperties.Name="터널 연결 진행"/>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,20" Margin="0,0,0,24">
                            <Grid Background="{DynamicResource BackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="상태" Style="{StaticResource Caption}"/><TextBlock Text="{Binding StateName}" Foreground="{Binding State, Converter={StaticResource StateBrush}}" FontFamily="Consolas" FontSize="15"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="연결 시간" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Uptime}" FontFamily="Consolas" FontSize="18"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="연결 시도" Style="{StaticResource Caption}"/><TextBlock Text="{Binding AttemptText}" FontSize="14"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,0,24" i:Motion.Watch="{Binding HasUrl}">
                            <StackPanel>
                                <TextBlock Text="{Binding UrlTitle}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                <TextBox Text="{Binding PublicUrl, Mode=OneWay}" IsReadOnly="True" Visibility="{Binding HasUrl, Converter={StaticResource BoolVisibility}}" FontFamily="Consolas" FontSize="21" Background="Transparent" BorderThickness="0" Padding="0,12" TextWrapping="Wrap" AutomationProperties.Name="공개 터널 URL"/>
                                <TextBlock Text="{Binding UrlDescription}" FontSize="16" Margin="0,10,0,8"/>
                                <TextBlock Text="{Binding Reachability}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,14"/>
                                <WrapPanel>
                                    <Button Command="{Binding CopyUrlCommand}" Margin="0,0,8,8" ToolTip="공개 URL 복사 / Ctrl+L"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="copy" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="주소 복사"/></StackPanel></Button>
                                    <Button Command="{Binding OpenUrlCommand}" Margin="0,0,8,8" ToolTip="기본 브라우저에서 열기"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="external" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="브라우저 열기"/></StackPanel></Button>
                                    <Button Command="{Binding ShowQrCommand}" Margin="0,0,0,8" ToolTip="외부 전송 없이 QR 코드 생성"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="qr" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="QR 코드"/></StackPanel></Button>
                                </WrapPanel>
                                <TextBlock Text="{Binding AccessDescription}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,6,0,0"/>
                                <TextBlock Text="Quick Tunnel 주소는 임시이며 중지하거나 다시 연결하면 변경됩니다. 민감한 서비스는 공개하지 마세요." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="로컬 서비스" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="로컬 웹 서버의 포트를 입력하세요. 서버는 터널 주소를 발급한 후 실행해도 됩니다." Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                        <Grid IsEnabled="{Binding CanEdit}" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><Label Target="{Binding ElementName=ServiceTypeInput}" Foreground="{DynamicResource MutedBrush}" Padding="0,0,0,8" Content="서비스 유형"/><ComboBox x:Name="ServiceTypeInput" ItemsSource="{Binding ServiceTypes}" SelectedItem="{Binding ServiceType}" AutomationProperties.Name="서비스 유형"/></StackPanel>
                            <StackPanel Grid.Column="2"><Label Target="{Binding ElementName=PortInput}" Foreground="{DynamicResource MutedBrush}" Padding="0,0,0,8" Content="로컬 포트"/><TextBox x:Name="PortInput" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="로컬 포트" ToolTip="개발 서버에서 사용하는 포트. 예: 3000, 8000, 8080"/></StackPanel>
                        </Grid>
                        <DockPanel Margin="0,0,0,20"><c:SvgIcon Kind="server" Stroke="{DynamicResource MutedBrush}" Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"/><TextBlock Text="{Binding LocalPreview}" FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}"/></DockPanel>

                    </StackPanel>
                    <StackPanel Visibility="{Binding IsAdvanced, Converter={StaticResource BoolVisibility}}" i:Motion.Watch="{Binding IsAdvanced}">
                        <TextBlock Text="내 환경에 맞는 연결." Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,12"/>
                        <TextBlock Text="고급 설정" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="변경 사항을 저장하면 다음 터널 실행부터 적용됩니다. 실행 중에는 연결 설정을 편집할 수 없습니다." Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,26"/>
                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <TextBlock Text="연결" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,10,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Cloudflared 로그 레벨" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" AutomationProperties.Name="Cloudflared 로그 레벨"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="연결 프로토콜" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" AutomationProperties.Name="연결 프로토콜"/></StackPanel>
                            </Grid>
                            <TextBlock Text="auto는 cloudflared가 프로토콜을 선택합니다. QUIC이 방화벽에 차단되면 http2를 시도하세요. debug 로그는 더 많은 요청 정보를 기록할 수 있습니다." Style="{StaticResource Caption}"/>
                            <CheckBox Content="HTTPS 서버 인증서 검증 생략" IsChecked="{Binding NoTlsVerify}" IsEnabled="{Binding IsHttps}" ToolTip="HTTPS 서비스에서만 적용됩니다. 기본값은 안전한 인증서 검증 사용입니다."/>
                            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0" Padding="12,4" Margin="0,0,0,18"><TextBlock Text="인증서 검증을 끄면 서버 신원을 확인하지 않습니다. 공격자가 로컬 연결을 가로챌 위험이 있습니다. 자체 서명 개발 인증서가 필요한 환경에서만 사용하세요." Foreground="{DynamicResource AccentBrush}" FontSize="12"/></Border>
                            <TextBlock Text="접근 제한" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="허용할 이메일 주소 (쉼표로 구분)" Style="{StaticResource Caption}" Margin="0,10,0,8"/>
                            <TextBox Text="{Binding AllowedEmails, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="접근 허용 이메일" ToolTip="비워두면 공개 접근을 허용합니다. 입력하면 CLI 지원 여부를 검사하고 PIN 인증을 요구합니다."/>
                            <TextBlock Text="{Binding EmailSupportText}" Style="{StaticResource Caption}" Margin="0,8,0,6"/>
                            <TextBlock Text="비워두면 주소를 아는 누구나 접근합니다. 이메일 제한은 최신 CLI의 --allowed-mail 기능을 사용하며 브라우저 PIN 인증이 필요합니다. 지원하지 않는 버전에서는 실행을 차단합니다." Style="{StaticResource Caption}" Margin="0,0,0,18"/>
                            <TextBlock Text="연결 복구 및 로그" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Content="연결이 끊어지면 자동으로 다시 연결" IsChecked="{Binding AutoReconnect}"/>
                            <DockPanel Margin="0,4,0,8"><TextBlock Text="최대 재시도 횟수 (0~10)" VerticalAlignment="Center"/><TextBox Text="{Binding RetryText, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="16,0,0,0" HorizontalAlignment="Left" MaxLength="2" AutomationProperties.Name="자동 재연결 최대 횟수"/></DockPanel>
                            <TextBlock Text="재시도하면 새로운 임시 주소가 발급될 수 있습니다. 중지 / 취소는 재시도 대기도 즉시 취소합니다." Style="{StaticResource Caption}"/>
                            <CheckBox Content="로그를 파일에 자동 저장 (5MB 순환 보관)" IsChecked="{Binding SaveLogFile}"/>
                            <TextBlock Text="공개 주소·이메일·일반적인 토큰 값은 로그에서 가립니다. 공유 전에 남은 개인정보와 서비스 응답 정보를 직접 확인하세요." Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                            <TextBlock Text="앱 시작과 시스템 트레이" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Content="앱을 실행하면 마지막 설정으로 터널 시작" IsChecked="{Binding StartTunnelOnLaunch}"/>
                            <TextBlock Text="켜면 앱 시작 즉시 로컬 서비스가 공개될 수 있습니다. Windows 로그인 자동 실행을 등록하는 옵션은 아닙니다." Style="{StaticResource Caption}"/>
                            <CheckBox Content="앱을 실행하면 트레이로 숨기기" IsChecked="{Binding StartInTray}"/>
                            <CheckBox Content="최소화하면 트레이로 숨기기" IsChecked="{Binding MinimizeToTray}"/>
                            <CheckBox Content="창 닫기 버튼을 누르면 트레이로 숨기기" IsChecked="{Binding CloseToTray}"/>
                            <CheckBox Content="연결 오류 및 중지 시 Windows 알림 표시" IsChecked="{Binding Notifications}"/>
                            <TextBlock Text="트레이의 프로그램 종료는 창 숨기기 설정과 관계없이 터널과 앱을 완전히 종료합니다." Style="{StaticResource Caption}" Margin="0,0,0,24"/>
                        </StackPanel>
                        <WrapPanel Margin="0,0,0,24"><Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Content="설정 저장" Margin="0,0,10,8" ToolTip="Ctrl+S"/><Button Command="{Binding OpenLogFolderCommand}" Content="로그 폴더 열기" Margin="0,0,0,8"/></WrapPanel>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,22,0,0" Margin="0,0,0,24"><StackPanel>
                            <TextBlock Text="Cloudflared 관리" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Version}" FontFamily="Consolas" Margin="0,8,0,10"/>
                            <TextBlock Text="{Binding ReleaseText}" Style="{StaticResource Caption}"/>
                            <TextBlock Text="공식 GitHub 배포 파일의 SHA256과 Windows 실행 파일 형식을 확인한 후 교체합니다. 실패하거나 취소하면 기존 버전은 그대로 유지됩니다." Style="{StaticResource Caption}" Margin="0,0,0,14"/>
                            <WrapPanel><Button Command="{Binding CheckUpdateCommand}" Content="업데이트 확인" Margin="0,0,10,8"/><Button Command="{Binding InstallCommand}" Content="최신 버전 설치 / 복구" Margin="0,0,0,8"/></WrapPanel>
                        </StackPanel></Border>
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Expander IsExpanded="{Binding LogsOpen}" i:Motion.Watch="{Binding LogsOpen}">
                            <Expander.Header><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="terminal" Stroke="{DynamicResource MutedBrush}" Width="17" Height="17" Margin="4,0,10,0"/><TextBlock Text="활동 로그"/><TextBlock Text="{Binding LogCount, StringFormat={}  /  {0}개}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="로그 검색" ToolTip="로그 메시지와 레벨에서 검색"/><ComboBox Grid.Column="2" ItemsSource="{Binding FilterLevels}" SelectedItem="{Binding LevelFilter}" AutomationProperties.Name="로그 레벨 필터"/></Grid>
                                <c:LogListBox x:Name="ActivityLog" Style="{StaticResource {x:Type ListBox}}" ItemsSource="{Binding FilteredLogs}" AutoScroll="{Binding AutoScroll}" Height="240" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="실시간 활동 로그" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/><TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12"/></Grid></DataTemplate></ListBox.ItemTemplate>
                                </c:LogListBox>
                                <WrapPanel Margin="0,10,0,0"><CheckBox Content="자동 스크롤" IsChecked="{Binding AutoScroll}" Margin="0,0,16,8"/><Button Content="복사" Command="{Binding CopyLogsCommand}" Margin="0,0,8,8"/><Button Content="저장" Command="{Binding SaveLogsCommand}" Margin="0,0,8,8"/><Button Content="초기화" Command="{Binding ClearLogsCommand}" Margin="0,0,0,8"/></WrapPanel>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
                    <Border x:Name="WorkPanel" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,12,0,0" Visibility="{Binding IsWorking, Converter={StaticResource BoolVisibility}}" i:Motion.Watch="{Binding IsWorking}"><StackPanel><TextBlock Text="{Binding WorkText}" Margin="0,0,0,10"/><ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Maximum="100" Height="4" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="다운로드 진행률"/></StackPanel></Border>
                        <WrapPanel Grid.Row="3" Margin="0,16,0,0">
                            <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" MinWidth="152" AutomationProperties.Name="터널 시작"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="play" Stroke="{DynamicResource AccentTextBrush}" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="터널 시작" Foreground="{DynamicResource AccentTextBrush}"/></StackPanel></Button>
                            <Button Command="{Binding StopCommand}" Margin="0,0,10,8" MinWidth="130" AutomationProperties.Name="터널 중지 또는 작업 취소"><StackPanel Orientation="Horizontal"><c:SvgIcon Kind="stop" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="중지 / 취소"/></StackPanel></Button>
                            <Button Command="{Binding ShowSettingsCommand}" Margin="0,0,0,8" Background="Transparent" BorderThickness="0" Content="고급 설정"/>
                        </WrapPanel>
            <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,12,0,0" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}" i:Motion.Watch="{Binding Notice}">
                <DockPanel><Button DockPanel.Dock="Right" Command="{Binding DismissNoticeCommand}" Content="닫기" MinHeight="28" Padding="8,3" Margin="12,0,0,0"/><TextBlock Text="{Binding Notice}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
