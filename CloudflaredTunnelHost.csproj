<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\Branding\app.ico</ApplicationIcon>
    <Title>Cloudflared Tunnel Host</Title>
    <Copyright>© 2024-2026 Ji Beak min(tharu8813). All rights reserved.</Copyright>
    <Authors></Authors>
    <Version>2.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Core\**;Tests\**" />
    <EmbeddedResource Remove="Core\**;Tests\**" />
    <Page Remove="Tests\**" />
    <ProjectReference Include="Core\CloudflaredTunnelHost.Core.csproj" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <Resource Include="Assets\Icons\*.svg;Assets\Branding\app.ico" />
    <Content Include="LICENSE;Assets\QRCoder-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
